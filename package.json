{
  "name": "baccarat-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.19.0",
    "npm": "10.9.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "preinstall": "node scripts/verify-runtime.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "dev": "npm run dev --workspace server",
    "dev:db": "docker compose up -d postgres",
    "dev:db:down": "docker compose down",
    "dev:all": "npm run dev:db && concurrently -k -n api,worker,web -c blue,magenta,green \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:worker": "npm run dev:worker --workspace server",
    "check:static": "node scripts/check-static.mjs && npm run typecheck",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run verify:runtime && npm run build --workspaces && node scripts/build-metadata.mjs write",
    "test:runtime": "node --test scripts/*.test.mjs",
    "test": "npm test --workspace @baccarat/contracts && npm test --workspace server",
    "test:integration": "npm run test:integration --workspace server",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=high",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:migrate:status": "npm run db:migrate:status --workspace server",
    "db:bootstrap": "npm run db:bootstrap --workspace server",
    "test:release": "node --test scripts/*.test.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:verify": "node scripts/build-metadata.mjs verify",
    "release:build": "npm run release:preflight && npm run build && npm run release:verify",
    "test:ops": "bash deploy/tests/run.sh",
    "db:seed": "npm run db:seed --workspace server",
    "test:deploy": "node deploy/scripts/test-systemd-hardening.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "concurrently": "^9.2.1"
  }
}
