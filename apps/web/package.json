{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "prebuild": "npm run build --workspace @baccarat/contracts",
    "build": "vue-tsc -b && vite build",
    "pretest": "npm run build --workspace @baccarat/contracts",
    "test": "vitest run && node --test src/tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@baccarat/contracts": "*",
    "axios": "^1.8.4",
    "pinia": "^4.0.2",
    "vue": "^3.5.25",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "axios-mock-adapter": "2.1.0",
    "happy-dom": "20.10.6",
    "postcss-mobile-forever": "^5.0.0",
    "sass": "^1.98.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "3.2.7",
    "vue-tsc": "^3.1.5"
  }
}
