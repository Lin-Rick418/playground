{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "prebuild": "npm run build --workspace @baccarat/contracts",
    "build": "vue-tsc -b && vite build",
    "pretest": "npm run build --workspace @baccarat/contracts",
    "test": "vitest run && node --test src/tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@baccarat/contracts": "*",
    "axios": "^1.8.4",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "axios-mock-adapter": "2.1.0",
    "happy-dom": "20.11.0",
    "postcss-mobile-forever": "^5.0.0",
    "sass": "1.101.0",
    "typescript": "~6.0.3",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7",
    "workbox-precaching": "7.4.1"
  }
}
