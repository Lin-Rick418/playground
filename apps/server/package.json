{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development NODE_ENV=development tsx watch src/index.ts",
    "dev:worker": "NODE_OPTIONS=--conditions=development NODE_ENV=development tsx watch src/worker.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "prebuild": "npm run build --workspace @baccarat/contracts",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build --workspace @baccarat/contracts",
    "test": "NODE_ENV=test tsx --test src/*.test.ts src/**/*.test.ts",
    "test:integration": "NODE_ENV=test tsx --test test/integration/**/*.test.ts",
    "test:db-integrity": "NODE_ENV=test RUN_DB_INTEGRATION_TESTS=true tsx --test src/lib/database-integrity.integration.test.ts",
    "test:daily-profit-db": "NODE_ENV=test RUN_DAILY_PROFIT_INTEGRATION_TESTS=true tsx --test src/lib/daily-profit.integration.test.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:maintenance": "node dist/scripts/maintenance.js",
    "db:seed": "NODE_ENV=development tsx src/scripts/seed.ts",
    "audit:verify": "tsx src/scripts/verify-shoe-audit.ts",
    "test:migrations-db": "NODE_ENV=test RUN_MIGRATION_INTEGRATION_TESTS=true tsx --test src/lib/migration-runner.integration.test.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:status": "tsx src/scripts/migration-status.ts",
    "db:bootstrap": "tsx src/scripts/bootstrap.ts",
    "db:maintenance": "tsx src/scripts/maintenance.ts"
  },
  "dependencies": {
    "@baccarat/contracts": "*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "10.3.1",
    "ws": "^8.18.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "pino-pretty": "13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  }
}
