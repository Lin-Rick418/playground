NODE_ENV=development
LOG_LEVEL=debug
# Integer from 1 through 65535.
PORT=4000
# IP address or DNS hostname.
HOST=0.0.0.0
JWT_SECRET=change-me
# Development/test may use *. Production accepts false or one exact http(s) origin.
CORS_ORIGIN=*
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/baccarat
# false, true, or no-verify (case-insensitive).
DATABASE_SSL=false
# Baccarat idempotency records are retained for this window. Mines keys are retained with game history.
IDEMPOTENCY_RETENTION_DAYS=7
# Expired or revoked sessions are retained this long for security investigation.
AUTH_SESSION_RETENTION_DAYS=30
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Stop new Mines rounds while allowing existing rounds to finish.
MINES_ENABLED=true

# Stop new Plinko bets; submitted results remain queryable/replayable.
PLINKO_ENABLED=true

# Hi-Lo stays disabled until migration and acceptance checks complete.
HILO_ENABLED=false
