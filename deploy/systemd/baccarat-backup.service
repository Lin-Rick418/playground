[Unit]
Description=Baccarat PostgreSQL Backup
After=postgresql.service

[Service]
Type=oneshot
User=baccarat-backup
Group=baccarat
UMask=0077
Environment=HOME=/nonexistent
ExecStart=/opt/baccarat/current/deploy/scripts/backup.sh create --env-file /etc/baccarat/baccarat.env --backup-dir /var/backups/baccarat
ExecStartPost=/opt/baccarat/current/deploy/scripts/backup.sh prune --backup-dir /var/backups/baccarat --keep 14 --apply
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/baccarat/current /etc/baccarat/baccarat.env
ReadWritePaths=/var/backups/baccarat
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
KeyringMode=private
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=4096
TasksMax=128
