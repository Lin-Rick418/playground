NODE_ENV=production
LOG_LEVEL=info
# IP address or DNS hostname. Keep loopback when nginx proxies locally.
HOST=127.0.0.1
# Integer from 1 through 65535.
PORT=4000
# Generate a unique value with: openssl rand -base64 48
JWT_SECRET=
DATABASE_URL=postgres://baccarat:replace-this-password@127.0.0.1:5432/baccarat
# Allowed values (case-insensitive): false = plain TCP,
# true = TLS with certificate verification, no-verify = TLS without
# verification (self-signed certs only). Any other value stops startup.
DATABASE_SSL=false
IDEMPOTENCY_RETENTION_DAYS=7
AUTH_SESSION_RETENTION_DAYS=30
# false disables cross-origin requests. Otherwise set one exact http(s) origin.
CORS_ORIGIN=false
# IANA timezone used to define the daily profit calendar window.
BUSINESS_TIME_ZONE=Asia/Taipei
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000
