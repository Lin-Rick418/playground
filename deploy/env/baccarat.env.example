NODE_ENV=production
HOST=127.0.0.1
PORT=4000
# Generate a unique value with: openssl rand -base64 48
JWT_SECRET=
DATABASE_URL=postgres://baccarat:replace-this-password@127.0.0.1:5432/baccarat
# false = plain TCP, true = TLS with certificate verification,
# no-verify = TLS without verification (self-signed certs only)
DATABASE_SSL=false
# IANA timezone used to define the daily profit calendar window.
BUSINESS_TIME_ZONE=Asia/Taipei
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000
